--- a/hidapi-hotplug/hidapi.h
+++ b/hidapi-hotplug/hidapi.h
@@ -565,6 +565,13 @@ extern "C" {
 			a hotplug callback, the deregistered callback will not be
 			invoked once the currently executing invocation returns.
 
+			On Windows, closing the last callback from inside a callback
+			defers draining the subscription and returns -1. An external
+			control caller must retry the same handle. Failed drains retain
+			the subscription and its context. Retry before releasing callback
+			resources or registering again. If hid_exit() reports a pending
+			or failed drain, retry hid_exit() before unloading the library.
+
 			See "Thread safety" on #hid_hotplug_register_callback for the
 			full thread-safety contract of the hotplug API.
 
