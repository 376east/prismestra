diff --git a/startup/ParentPipe.h b/startup/ParentPipe.h
new file mode 100644
index 0000000000000000000000000000000000000000..2b22a43135822d0730b9fe0e3bc995929c71ee06
--- /dev/null
+++ b/startup/ParentPipe.h
@@ -0,0 +1,24 @@
+// Optional private owner-lifetime pipe; no public shutdown endpoint.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#if defined(_WIN32) && defined(PRISMESTRA_PC_BACKEND)
+#include <windows.h>
+
+inline HANDLE PrismestraParentPipe()
+{
+    WCHAR enabled[2] = {};
+    if(GetEnvironmentVariableW(L"PRISMESTRA_PARENT_PIPE", enabled, 2) != 1 || enabled[0] != L'1')
+        return NULL;
+    HANDLE input = GetStdHandle(STD_INPUT_HANDLE);
+    return input && input != INVALID_HANDLE_VALUE && GetFileType(input) == FILE_TYPE_PIPE ? input : NULL;
+}
+
+inline bool PrismestraParentPipeClosed(HANDLE input)
+{
+    DWORD available = 0;
+    // The parent never writes data. EOF is detected without a blocking reader
+    // thread; an unusable inherited pipe also ends this opted-in session.
+    return !PeekNamedPipe(input, NULL, 0, NULL, &available, NULL);
+}
+#endif
diff --git a/startup/PcTimerResolution.h b/startup/PcTimerResolution.h
new file mode 100644
index 0000000000000000000000000000000000000000..3d6fdb38a78608a35ecdeffb89395a8192f399cf
--- /dev/null
+++ b/startup/PcTimerResolution.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Preserve short protocol delays without the donor's repeating 0.5ms worker.
+#pragma once
+#include <windows.h>
+#include <timeapi.h>
+
+class PcTimerResolution
+{
+    bool active = false;
+    bool restore_policy = false;
+    PROCESS_POWER_THROTTLING_STATE previous = {};
+public:
+    DWORD error = ERROR_SUCCESS;
+    DWORD policy_error = ERROR_SUCCESS;
+    explicit PcTimerResolution(bool hardware_active)
+    {
+        if(!hardware_active) return;
+        // Older Windows uses a GLOBAL timer request. Do not opt into that.
+        using VersionFunction = LONG (WINAPI*)(OSVERSIONINFOW*);
+        auto version_fn = reinterpret_cast<VersionFunction>(GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "RtlGetVersion"));
+        OSVERSIONINFOW version = {};
+        version.dwOSVersionInfoSize = sizeof(version);
+        if(!version_fn || version_fn(&version) != 0 || version.dwMajorVersion < 10 ||
+           (version.dwMajorVersion == 10 && version.dwBuildNumber < 19041))
+        {
+            error = ERROR_OLD_WIN_VERSION;
+            return;
+        }
+        previous.Version = PROCESS_POWER_THROTTLING_CURRENT_VERSION;
+        if(GetProcessInformation(GetCurrentProcess(), ProcessPowerThrottling, &previous, sizeof(previous)))
+        {
+            auto policy = previous;
+            policy.ControlMask |= PROCESS_POWER_THROTTLING_IGNORE_TIMER_RESOLUTION;
+            policy.StateMask &= ~PROCESS_POWER_THROTTLING_IGNORE_TIMER_RESOLUTION;
+            restore_policy = SetProcessInformation(GetCurrentProcess(), ProcessPowerThrottling, &policy, sizeof(policy)) != 0;
+            if(!restore_policy) policy_error = GetLastError();
+        }
+        else policy_error = GetLastError();
+        const MMRESULT result = timeBeginPeriod(1);
+        active = result == TIMERR_NOERROR;
+        if(!active) error = result;
+    }
+    ~PcTimerResolution()
+    {
+        if(active) timeEndPeriod(1);
+        if(restore_policy) SetProcessInformation(GetCurrentProcess(), ProcessPowerThrottling, &previous, sizeof(previous));
+    }
+    bool enabled() const { return active; }
+    PcTimerResolution(const PcTimerResolution&) = delete;
+    PcTimerResolution& operator=(const PcTimerResolution&) = delete;
+};
