+using namespace deferred_i2c;
+
+struct Holder
+{
+    HANDLE mutex;
+    HANDLE ready = CreateEventA(nullptr, TRUE, FALSE, nullptr);
+    HANDLE release = CreateEventA(nullptr, TRUE, FALSE, nullptr);
+    std::thread thread;
+    explicit Holder(HANDLE target) : mutex(target), thread([this] {
+        const DWORD result = WaitForSingleObject(mutex, 1000);
+        assert(result == WAIT_OBJECT_0 || result == WAIT_ABANDONED);
+        SetEvent(ready);
+        assert(WaitForSingleObject(release, 3000) == WAIT_OBJECT_0);
+        assert(ReleaseMutex(mutex));
+    }) { assert(WaitForSingleObject(ready, 1000) == WAIT_OBJECT_0); }
+    ~Holder() { SetEvent(release); thread.join(); CloseHandle(ready); CloseHandle(release); }
+};
+
+int main()
+{
+    const std::string name = "Local\\Prismestra-Deferred-I2C-Fixture-" + std::to_string(GetCurrentProcessId());
+    HANDLE mutex = CreateMutexA(nullptr, FALSE, name.c_str());
+    assert(mutex);
+    unsigned io_calls = 0, buses = 0, hid_passes = 0;
+    Phase phase;
+    const auto now = Clock::now();
+    {
+        Holder holder(mutex);
+        const auto began = Clock::now();
+        assert(!admit(phase, name.c_str(), now));
+        assert(Clock::now() - began < std::chrono::seconds(1));
+        assert(phase.stage == Stage::Deferred && buses == 0 && io_calls == 0);
+        ++hid_passes; // Busy initial I2C admission does not postpone HID.
+        assert(!phase.due(now + std::chrono::milliseconds(999)));
+        assert(phase.due(now + std::chrono::seconds(1)));
+        assert(!admit(phase, name.c_str(), now + std::chrono::seconds(1)));
+        assert(phase.retry_at == now + std::chrono::seconds(3));
+        Access denied(mutex);
+        assert(!denied && denied.failure() == ERROR_TIMEOUT);
+        assert(FAILED(denied.invoke([&]() -> HRESULT { ++io_calls; return S_OK; })));
+        assert(io_calls == 0);
+    }
+    assert(admit(phase, name.c_str(), now + std::chrono::seconds(3)));
+    ++buses;
+    {
+        ProbeBudget budget;
+        Access owned(mutex);
+        assert(owned && SUCCEEDED(owned.invoke([&]() -> HRESULT { ++io_calls; return S_OK; })));
+        phase.finish(budget.blocked());
+    }
+    assert(phase.stage == Stage::Complete && buses == 1 && hid_passes == 1 && io_calls == 1);
+    assert(!admit(phase, name.c_str(), now + std::chrono::hours(10)));
+    assert(!phase.due(now + std::chrono::hours(10)));
