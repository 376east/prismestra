+    assert(!phase.due(now + std::chrono::hours(10)));
+    assert(!admit(phase, name.c_str(), now + std::chrono::hours(10)));
+    { Access output(mutex); assert(SUCCEEDED(output.invoke([&]() -> HRESULT { ++io_calls; return S_OK; }))); }
