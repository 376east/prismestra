+void DetectionManager::BackgroundDetectI2CPhase(json& detector_settings)
+{
+#ifdef _WIN32
+    // Preflight precedes ALL bus creation; the guard in admit() is released
+    // immediately. Holding it over detection would starve other applications.
+    if(!deferred_i2c::admit(i2c_phase, GLOBAL_SMBUS_MUTEX_NAME, deferred_i2c::Clock::now()))
+    {
+        if(i2c_phase.stage == deferred_i2c::Stage::Deferred)
+            LOG_WARNING("[%s] Shared SMBus is busy; I2C discovery deferred, independent discovery continues", DETECTIONMANAGER);
+        else
+            LOG_ERROR("[%s] SMBus coordination unavailable; I2C discovery not started", DETECTIONMANAGER);
+        return;
+    }
+    deferred_i2c::ProbeBudget budget(&i2c_retry_cancelled);
+#else
+    i2c_phase.stage = deferred_i2c::Stage::Running;
+#endif
+    try
+    {
+        BackgroundDetectI2CBuses();
+        BackgroundDetectI2CDevices(detector_settings);
+        BackgroundDetectI2CDRAMDevices(detector_settings);
+        BackgroundDetectI2CPCIDevices(detector_settings);
+#ifdef _WIN32
+        i2c_phase.finish(budget.blocked());
+#else
+        i2c_phase.finish(false);
+#endif
+    }
+    catch(...) { i2c_phase.finish(true); throw; }
+    if(i2c_phase.stage == deferred_i2c::Stage::Partial)
+        LOG_WARNING("[%s] I2C discovery partial after contention; automatic rescan disabled to preserve registered controllers. Manual rescan is available", DETECTIONMANAGER);
+}
+
+void DetectionManager::BackgroundRetryI2C()
+{
+    if(stopping.load() || i2c_retry_cancelled.load()) return;
+    bool expected = false;
+    if(!detection_in_progress.compare_exchange_strong(expected, true)) return;
+    std::lock_guard detection_lock(DetectDevicesMutex);
+    try
+    {
+        json detector_settings = ResourceManager::get()->GetSettingsManager()->GetSettings("Detectors");
+        BackgroundDetectI2CPhase(detector_settings);
+        if(i2c_phase.stage == deferred_i2c::Stage::Complete || i2c_phase.stage == deferred_i2c::Stage::Partial)
+        {
+            WriteDetectorMap();
+            // Existing registration callbacks already publish each new SDK
+            // controller; this completes the pass without touching HID owners.
+            SignalUpdate(DETECTIONMANAGER_UPDATE_REASON_DETECTION_COMPLETE);
+        }
+    }
+    catch(...) { detection_in_progress = false; throw; }
+    detection_in_progress = false;
+}
