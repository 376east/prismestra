diff --git a/DeferredI2C.h b/DeferredI2C.h
new file mode 100644
index 0000000000000000000000000000000000000000..8cb0065f32918bcb9ac776402f55cf94590dd0ce
--- /dev/null
+++ b/DeferredI2C.h
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Local coexistence patch: no thread, controller or driver ownership here.
+#pragma once
+#include <chrono>
+#include <cstddef>
+
+namespace deferred_i2c
+{
+using Clock = std::chrono::steady_clock;
+enum class Stage { NotStarted, Deferred, Running, Complete, Partial, Stopped };
+struct Phase
+{
+    Stage stage = Stage::NotStarted;
+    Clock::time_point retry_at{};
+    std::size_t failures = 0;
+    void reset() { *this = Phase{}; }
+    void stop() { stage = Stage::Stopped; }
+    bool due(Clock::time_point now) const { return stage == Stage::Deferred && now >= retry_at; }
+    void defer(Clock::time_point now)
+    {
+        static constexpr unsigned seconds[] = {1, 2, 5, 15, 30, 60};
+        const auto index = failures < 5 ? failures : 5;
+        if(failures < 5) ++failures;
+        retry_at = now + std::chrono::seconds(seconds[index]);
+        stage = Stage::Deferred;
+    }
+    void finish(bool incomplete) { stage = incomplete ? Stage::Partial : Stage::Complete; }
+};
+}
diff --git a/DeferredI2CAccess.h b/DeferredI2CAccess.h
new file mode 100644
index 0000000000000000000000000000000000000000..6b23c5f3864005da8cbe52adda0c735cabbebbb7
--- /dev/null
+++ b/DeferredI2CAccess.h
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Windows-only SMBus access policy. Never include from DetectionManager.h.
+#pragma once
+#include "DeferredI2C.h"
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <atomic>
+#include <utility>
+namespace deferred_i2c
+{
+// Only mutex waiting is budgeted; synchronous kernel IOCTLs are not cancellable
+// by this helper. Output transactions have a separate100ms per-call cap.
+struct WaitBudget { DWORD remaining_ms = 100; bool blocked = false; const std::atomic<bool>* cancelled = nullptr; };
+inline thread_local WaitBudget* current_budget = nullptr;
+class ProbeBudget
+{
+    WaitBudget budget;
+    WaitBudget* previous;
+public:
+    explicit ProbeBudget(const std::atomic<bool>* cancelled = nullptr) : previous(current_budget) { budget.cancelled = cancelled; current_budget = &budget; }
+    ~ProbeBudget() { current_budget = previous; }
+    bool blocked() const { return budget.blocked || (budget.cancelled && budget.cancelled->load()); }
+    ProbeBudget(const ProbeBudget&) = delete;
+    ProbeBudget& operator=(const ProbeBudget&) = delete;
+};
+inline bool probe_blocked() { return current_budget && (current_budget->blocked || (current_budget->cancelled && current_budget->cancelled->load())); }
+
+class Access
+{
+    HANDLE handle;
+    bool close_handle;
+    bool acquired = false;
+    DWORD error = ERROR_SUCCESS;
+    void wait(DWORD timeout_ms)
+    {
+        if(!handle) { error = ERROR_INVALID_HANDLE; if(current_budget) current_budget->blocked = true; return; }
+        if(current_budget)
+        {
+            if(probe_blocked() || current_budget->remaining_ms == 0)
+            { current_budget->blocked = true; error = ERROR_TIMEOUT; return; }
+            if(timeout_ms > current_budget->remaining_ms) timeout_ms = current_budget->remaining_ms;
+        }
+        const ULONGLONG began = GetTickCount64();
+        const DWORD result = WaitForSingleObject(handle, timeout_ms);
+        const DWORD wait_error = result == WAIT_FAILED ? GetLastError() : ERROR_SUCCESS;
+        if(current_budget)
+        {
+            const ULONGLONG elapsed = GetTickCount64() - began;
+            current_budget->remaining_ms = elapsed >= current_budget->remaining_ms ? 0 : current_budget->remaining_ms - static_cast<DWORD>(elapsed);
+        }
+        if(result == WAIT_OBJECT_0 || result == WAIT_ABANDONED) { acquired = true; return; }
+        error = result == WAIT_TIMEOUT ? ERROR_TIMEOUT : (wait_error ? wait_error : ERROR_GEN_FAILURE);
+        if(current_budget) current_budget->blocked = true;
+    }
+public:
+    explicit Access(HANDLE borrowed, DWORD timeout_ms = 100) : handle(borrowed), close_handle(false) { wait(timeout_ms); }
+    explicit Access(const char* name, DWORD timeout_ms = 100) : handle(CreateMutexA(nullptr, FALSE, name)), close_handle(true)
+    {
+        if(!handle) { error = GetLastError(); if(current_budget) current_budget->blocked = true; }
+        else wait(timeout_ms);
+    }
+    ~Access() { if(acquired) ReleaseMutex(handle); if(close_handle && handle) CloseHandle(handle); }
+    explicit operator bool() const { return acquired; }
+    DWORD failure() const { return error; }
+    template<typename Operation> HRESULT invoke(Operation&& operation) const
+    {
+        if(!acquired) return HRESULT_FROM_WIN32(error ? error : ERROR_GEN_FAILURE);
+        return std::forward<Operation>(operation)();
+    }
+    Access(const Access&) = delete;
+    Access& operator=(const Access&) = delete;
+};
+
+// Called before any I2C buses exist. The temporary guard is released before
+// returning success: never hold the shared SMBus mutex over whole discovery.
+inline bool admit(Phase& phase, const char* name, Clock::time_point now)
+{
+    if(phase.stage != Stage::NotStarted && phase.stage != Stage::Deferred) return false;
+    Access access(name, 100);
+    if(!access)
+    {
+        if(access.failure() == ERROR_TIMEOUT) phase.defer(now);
+        else phase.finish(true);
+        return false;
+    }
+    phase.stage = Stage::Running;
+    return true;
+}
+}
